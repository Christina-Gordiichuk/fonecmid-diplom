#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Процедура ОбработкаПроведения(Отказ, Режим)

	СтрокиНачисления = ВКМ_СтрокиНачисленияДляПроведения();
	Если СтрокиНачисления.Количество() = 0 Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru='Не заполнены сотрудники для начисления.'"));
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Движения.ВКМ_НачисленияСотрудников.Записывать = Истина;
	Движения.ВКМ_ВзаиморасчетыССотрудниками.Записывать = Истина;

	Для Каждого СтрокаНачисления Из СтрокиНачисления Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаНачисления.Сотрудник) Тогда
			ОбщегоНазначения.СообщитьПользователю(НСтр("ru='Не заполнен сотрудник.'"));
			Отказ = Истина;
			Возврат;
		КонецЕсли;

		СуммаНачисления = СтрокаНачисления.СуммаНачисления;
		Если НЕ ЗначениеЗаполнено(СуммаНачисления) Или СуммаНачисления <= 0 Тогда
			СуммаНачисления = ВКМ_РассчитатьСуммуНачисленияПоУсловиямОплаты(СтрокаНачисления.Сотрудник, Дата);
		КонецЕсли;

		Если НЕ ЗначениеЗаполнено(СуммаНачисления) Или СуммаНачисления <= 0 Тогда
			ОбщегоНазначения.СообщитьПользователю(
				СтрШаблон(НСтр("ru='Сумма начисления для сотрудника %1 должна быть больше нуля.'"), СтрокаНачисления.Сотрудник));
			Отказ = Истина;
			Возврат;
		КонецЕсли;

		НДФЛ = ВКМ_ОбслуживаниеКлиентов.ВКМ_РассчитатьНДФЛ(СуммаНачисления);
		СуммаКВыплате = СуммаНачисления - НДФЛ;

		ДвижениеНачисление = Движения.ВКМ_НачисленияСотрудников.Добавить();
		ДвижениеНачисление.Период = Дата;
		ДвижениеНачисление.ВКМ_Сотрудник = СтрокаНачисления.Сотрудник;
		ДвижениеНачисление.ВКМ_ВидНачисления = НСтр("ru='Оклад'");
		ДвижениеНачисление.ВКМ_СуммаНачисления = СуммаНачисления;

		ДвижениеНДФЛ = Движения.ВКМ_НачисленияСотрудников.Добавить();
		ДвижениеНДФЛ.Период = Дата;
		ДвижениеНДФЛ.ВКМ_Сотрудник = СтрокаНачисления.Сотрудник;
		ДвижениеНДФЛ.ВКМ_ВидНачисления = НСтр("ru='НДФЛ'");
		ДвижениеНДФЛ.ВКМ_СуммаНачисления = -НДФЛ;

		ДвижениеВзаиморасчетов = Движения.ВКМ_ВзаиморасчетыССотрудниками.Добавить();
		ДвижениеВзаиморасчетов.ВидДвижения = ВидДвиженияНакопления.Приход;
		ДвижениеВзаиморасчетов.Период = Дата;
		ДвижениеВзаиморасчетов.ВКМ_Сотрудник = СтрокаНачисления.Сотрудник;
		ДвижениеВзаиморасчетов.ВКМ_Сумма = СуммаКВыплате;
	КонецЦикла;

КонецПроцедуры

Функция ВКМ_СтрокиНачисленияДляПроведения()

	СтрокиНачисления = Новый Массив;

	Если ВКМ_Начисления.Количество() > 0 Тогда
		Для Каждого СтрокаТЧ Из ВКМ_Начисления Цикл
			СтрокиНачисления.Добавить(Новый Структура("Сотрудник, СуммаНачисления",
				СтрокаТЧ.ВКМ_Сотрудник, СтрокаТЧ.ВКМ_СуммаНачисления));
		КонецЦикла;
	ИначеЕсли ЗначениеЗаполнено(ВКМ_Сотрудник) Тогда
		СтрокиНачисления.Добавить(Новый Структура("Сотрудник, СуммаНачисления",
			ВКМ_Сотрудник, ВКМ_СуммаНачисления));
	КонецЕсли;

	Возврат СтрокиНачисления;

КонецФункции

Функция ВКМ_РассчитатьСуммуНачисленияПоУсловиямОплаты(Сотрудник, ДатаДокумента)

	ЗапросУсловияОплаты = Новый Запрос;
	ЗапросУсловияОплаты.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	УсловияОплаты.ВКМ_Оклад КАК ВКМ_Оклад
	|ИЗ
	|	РегистрСведений.ВКМ_УсловияОплатыСотрудников КАК УсловияОплаты
	|ГДЕ
	|	УсловияОплаты.ВКМ_Сотрудник = &Сотрудник
	|	И УсловияОплаты.Период <= &ДатаДокумента
	|УПОРЯДОЧИТЬ ПО
	|	УсловияОплаты.Период УБЫВ";
	ЗапросУсловияОплаты.УстановитьПараметр("Сотрудник", Сотрудник);
	ЗапросУсловияОплаты.УстановитьПараметр("ДатаДокумента", ДатаДокумента);

	ВыборкаУсловий = ЗапросУсловияОплаты.Выполнить().Выбрать();
	Если НЕ ВыборкаУсловий.Следующий() Тогда
		Возврат 0;
	КонецЕсли;

	ЗапросВыработки = Новый Запрос;
	ЗапросВыработки.Текст =
	"ВЫБРАТЬ
	|	СУММА(Выработка.ВКМ_СуммаКОплатеОборот) КАК ВКМ_СуммаПоРаботам
	|ИЗ
	|	РегистрНакопления.ВКМ_ВыполненныеСотрудникомРаботы.Обороты(&НачалоПериода, &КонецПериода, , ВКМ_Сотрудник = &Сотрудник) КАК Выработка";
	ЗапросВыработки.УстановитьПараметр("Сотрудник", Сотрудник);
	ЗапросВыработки.УстановитьПараметр("НачалоПериода", НачалоМесяца(ДатаДокумента));
	ЗапросВыработки.УстановитьПараметр("КонецПериода", КонецМесяца(ДатаДокумента));

	ВыборкаВыработки = ЗапросВыработки.Выполнить().Выбрать();
	СуммаПоРаботам = 0;
	Если ВыборкаВыработки.Следующий() Тогда
		СуммаПоРаботам = ?(ЗначениеЗаполнено(ВыборкаВыработки.ВКМ_СуммаПоРаботам), ВыборкаВыработки.ВКМ_СуммаПоРаботам, 0);
	КонецЕсли;

	Возврат Окр(ВыборкаУсловий.ВКМ_Оклад + СуммаПоРаботам, 2);

КонецФункции

#КонецЕсли
