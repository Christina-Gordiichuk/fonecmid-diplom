#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	ВКМ_ЗаполнитьСотрудникиСтрокой();

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)

	СтрокиНачисления = ВКМ_СтрокиНачисленияДляПроведения();
	Если СтрокиНачисления.Количество() = 0 Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru='Не заполнены сотрудники для начисления.'"));
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	ВКМ_ОбеспечитьГрафикПоСтрокам(СтрокиНачисления);

	Движения.ВКМ_ОсновныеНачисления.Записывать = Истина;
	Движения.ВКМ_ДополнительныеНачисления.Записывать = Истина;
	Движения.ВКМ_Удержания.Записывать = Истина;
	Движения.ВКМ_ВзаиморасчетыССотрудниками.Записывать = Истина;

	ВКМ_СформироватьОсновныеНачисления(СтрокиНачисления);
	Движения.ВКМ_ОсновныеНачисления.Записать();
	ВКМ_ДобавитьДополнениеОсновныхНачислений();
	ВКМ_РасчетЗарплаты.ВКМ_РассчитатьОсновныеНачисления(Ссылка);
	Движения.ВКМ_ОсновныеНачисления.Прочитать();

	ВКМ_СформироватьДополнительныеНачисления(СтрокиНачисления);
	Движения.ВКМ_ДополнительныеНачисления.Записать();
	Движения.ВКМ_ДополнительныеНачисления.Прочитать();

	ВКМ_СформироватьУдержанияИВзаиморасчеты(СтрокиНачисления);

КонецПроцедуры

Функция ВКМ_СтрокиНачисленияДляПроведения()

	СтрокиНачисления = Новый Массив;

	Для Каждого СтрокаТЧ Из ВКМ_Начисления Цикл
		СтрокиНачисления.Добавить(Новый Структура(
			"Сотрудник, ВидРасчета, ДатаНачала, ДатаОкончания, СуммаНачисления",
			СтрокаТЧ.ВКМ_Сотрудник, СтрокаТЧ.ВКМ_ВидРасчета,
			СтрокаТЧ.ВКМ_ДатаНачала, СтрокаТЧ.ВКМ_ДатаОкончания, СтрокаТЧ.ВКМ_СуммаНачисления));
	КонецЦикла;

	Возврат СтрокиНачисления;

КонецФункции

Процедура ВКМ_ЗаполнитьСотрудникиСтрокой()

	ИменаСотрудников = Новый Массив;
	ОбработанныеСотрудники = Новый Соответствие;

	Для Каждого СтрокаТЧ Из ВКМ_Начисления Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаТЧ.ВКМ_Сотрудник) Тогда
			Продолжить;
		КонецЕсли;
		Если ОбработанныеСотрудники.Получить(СтрокаТЧ.ВКМ_Сотрудник) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ОбработанныеСотрудники.Вставить(СтрокаТЧ.ВКМ_Сотрудник, Истина);
		ИменаСотрудников.Добавить(Строка(СтрокаТЧ.ВКМ_Сотрудник));
	КонецЦикла;

	ВКМ_СотрудникиСтрокой = СтрСоединить(ИменаСотрудников, ", ");

КонецПроцедуры

Процедура ВКМ_ОбеспечитьГрафикПоСтрокам(СтрокиНачисления)

	МинимальнаяДата = НачалоМесяца(Дата);
	МаксимальнаяДата = КонецМесяца(Дата);

	Для Каждого СтрокаНачисления Из СтрокиНачисления Цикл
		Если ЗначениеЗаполнено(СтрокаНачисления.ДатаНачала) Тогда
			МинимальнаяДата = Мин(МинимальнаяДата, НачалоДня(СтрокаНачисления.ДатаНачала));
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаНачисления.ДатаОкончания) Тогда
			МаксимальнаяДата = Макс(МаксимальнаяДата, КонецДня(СтрокаНачисления.ДатаОкончания));
		КонецЕсли;
	КонецЦикла;

	ВКМ_РасчетЗарплаты.ВКМ_ОбеспечитьГрафикРаботы(
		ДобавитьМесяц(НачалоМесяца(МинимальнаяДата), -12), МаксимальнаяДата);

КонецПроцедуры

Процедура ВКМ_СформироватьОсновныеНачисления(СтрокиНачисления)

	ВидОклад = ПланыВидовРасчета.ВКМ_ОсновныеНачисления.ВКМ_Оклад;
	ВидОтпуск = ПланыВидовРасчета.ВКМ_ОсновныеНачисления.ВКМ_Отпуск;

	Для Каждого СтрокаНачисления Из СтрокиНачисления Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаНачисления.Сотрудник) Тогда
			Продолжить;
		КонецЕсли;

		Если СтрокаНачисления.ВидРасчета <> ВидОклад И СтрокаНачисления.ВидРасчета <> ВидОтпуск Тогда
			Продолжить;
		КонецЕсли;

		ДатаНачала = ?(ЗначениеЗаполнено(СтрокаНачисления.ДатаНачала),
			НачалоДня(СтрокаНачисления.ДатаНачала), НачалоМесяца(Дата));
		ДатаОкончания = ?(ЗначениеЗаполнено(СтрокаНачисления.ДатаОкончания),
			КонецДня(СтрокаНачисления.ДатаОкончания), КонецМесяца(Дата));

		Движение = Движения.ВКМ_ОсновныеНачисления.Добавить();
		Движение.ПериодРегистрации = НачалоМесяца(Дата);
		Движение.ВидРасчета = СтрокаНачисления.ВидРасчета;
		Движение.ВКМ_Сотрудник = СтрокаНачисления.Сотрудник;
		Движение.ПериодДействияНачало = ДатаНачала;
		Движение.ПериодДействияКонец = ДатаОкончания;

		Если СтрокаНачисления.ВидРасчета = ВидОтпуск Тогда
			Движение.БазовыйПериодНачало = ДобавитьМесяц(НачалоМесяца(ДатаНачала), -12);
			Движение.БазовыйПериодКонец = НачалоМесяца(ДатаНачала) - 1;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ВКМ_ДобавитьДополнениеОсновныхНачислений()

	Если Движения.ВКМ_ОсновныеНачисления.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Дополнение = Движения.ВКМ_ОсновныеНачисления.ПолучитьДополнение();
	Если Дополнение.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Для Каждого СтрокаДополнения Из Дополнение Цикл
		Движение = Движения.ВКМ_ОсновныеНачисления.Добавить();
		ЗаполнитьЗначенияСвойств(Движение, СтрокаДополнения);
		Движение.ПериодРегистрации = НачалоМесяца(Дата);
		Движение.Сторно = Истина;
	КонецЦикла;

	Движения.ВКМ_ОсновныеНачисления.Записать();

КонецПроцедуры

Процедура ВКМ_СформироватьДополнительныеНачисления(СтрокиНачисления)

	ВидПроцент = ПланыВидовРасчета.ВКМ_ДополнительныеНачисления.ВКМ_ПроцентОтРабот;
	СотрудникиПроцента = Новый Массив;

	Для Каждого СтрокаНачисления Из СтрокиНачисления Цикл
		Если СтрокаНачисления.ВидРасчета <> ВидПроцент Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(СтрокаНачисления.Сотрудник) Тогда
			Продолжить;
		КонецЕсли;
		Если СотрудникиПроцента.Найти(СтрокаНачисления.Сотрудник) = Неопределено Тогда
			СотрудникиПроцента.Добавить(СтрокаНачисления.Сотрудник);
		КонецЕсли;
	КонецЦикла;

	СуммыПроцента = ВКМ_РасчетЗарплаты.ВКМ_СуммыПроцентаОтРаботЗаМесяц(СотрудникиПроцента, Дата);

	Для Каждого СтрокаНачисления Из СтрокиНачисления Цикл
		Если СтрокаНачисления.ВидРасчета <> ВидПроцент Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(СтрокаНачисления.Сотрудник) Тогда
			Продолжить;
		КонецЕсли;

		СуммаПроцента = СуммыПроцента.Получить(СтрокаНачисления.Сотрудник);
		Если СуммаПроцента = Неопределено Тогда
			СуммаПроцента = 0;
		КонецЕсли;

		Движение = Движения.ВКМ_ДополнительныеНачисления.Добавить();
		Движение.ПериодРегистрации = НачалоМесяца(Дата);
		Движение.ВидРасчета = ВидПроцент;
		Движение.ВКМ_Сотрудник = СтрокаНачисления.Сотрудник;
		Движение.БазовыйПериодНачало = НачалоМесяца(Дата);
		Движение.БазовыйПериодКонец = КонецМесяца(Дата);
		Движение.ВКМ_Результат = СуммаПроцента;
	КонецЦикла;

КонецПроцедуры

Процедура ВКМ_СформироватьУдержанияИВзаиморасчеты(СтрокиНачисления)

	Сотрудники = Новый Соответствие;
	Для Каждого СтрокаНачисления Из СтрокиНачисления Цикл
		Если ЗначениеЗаполнено(СтрокаНачисления.Сотрудник) Тогда
			Сотрудники.Вставить(СтрокаНачисления.Сотрудник, Истина);
		КонецЕсли;
	КонецЦикла;

	БазаПоСотрудникам = ВКМ_РасчетЗарплаты.ВКМ_БазаНачисленийПоРегистратору(Ссылка);

	Для Каждого КлючИЗначение Из Сотрудники Цикл
		Сотрудник = КлючИЗначение.Ключ;
		БазаНДФЛ = БазаПоСотрудникам.Получить(Сотрудник);
		Если БазаНДФЛ = Неопределено Тогда
			БазаНДФЛ = 0;
		КонецЕсли;
		НДФЛ = ВКМ_РасчетЗарплаты.ВКМ_РассчитатьНДФЛ(БазаНДФЛ);

		ДвижениеНДФЛ = Движения.ВКМ_Удержания.Добавить();
		ДвижениеНДФЛ.ПериодРегистрации = НачалоМесяца(Дата);
		ДвижениеНДФЛ.ВидРасчета = ПланыВидовРасчета.ВКМ_Удержания.ВКМ_НДФЛ;
		ДвижениеНДФЛ.ВКМ_Сотрудник = Сотрудник;
		ДвижениеНДФЛ.БазовыйПериодНачало = НачалоМесяца(Дата);
		ДвижениеНДФЛ.БазовыйПериодКонец = КонецМесяца(Дата);
		ДвижениеНДФЛ.ВКМ_Результат = НДФЛ;
	КонецЦикла;

	Движения.ВКМ_Удержания.Записать();

	СуммыКВыплате = ВКМ_РасчетЗарплаты.ВКМ_СуммыВзаиморасчетовПоРегистратору(Ссылка);

	Для Каждого КлючИЗначение Из Сотрудники Цикл
		Сотрудник = КлючИЗначение.Ключ;
		СуммаКВыплате = СуммыКВыплате.Получить(Сотрудник);
		Если СуммаКВыплате = Неопределено Или СуммаКВыплате = 0 Тогда
			Продолжить;
		КонецЕсли;

		ДвижениеВзаиморасчетов = Движения.ВКМ_ВзаиморасчетыССотрудниками.Добавить();
		ДвижениеВзаиморасчетов.ВидДвижения = ВидДвиженияНакопления.Приход;
		ДвижениеВзаиморасчетов.Период = Дата;
		ДвижениеВзаиморасчетов.ВКМ_Сотрудник = Сотрудник;
		ДвижениеВзаиморасчетов.ВКМ_Сумма = СуммаКВыплате;
	КонецЦикла;

КонецПроцедуры

#КонецЕсли
