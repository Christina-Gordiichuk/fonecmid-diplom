#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)

	ВКМ_ЗаполнитьПоОстаткамВзаиморасчетов();

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)

	СтрокиВыплат = ВКМ_СтрокиВыплатДляПроведения();
	Если СтрокиВыплат.Количество() = 0 Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru='Не заполнены выплаты сотрудникам.'"));
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Движения.ВКМ_ВзаиморасчетыССотрудниками.Записывать = Истина;

	Для Каждого СтрокаВыплаты Из СтрокиВыплат Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаВыплаты.Сотрудник) Тогда
			ОбщегоНазначения.СообщитьПользователю(НСтр("ru='Не заполнен сотрудник.'"));
			Отказ = Истина;
			Возврат;
		КонецЕсли;

		ДоступныйОстаток = ВКМ_ПолучитьОстатокВзаиморасчетов(СтрокаВыплаты.Сотрудник, Дата);
		СуммаВыплаты = СтрокаВыплаты.Сумма;

		Если НЕ ЗначениеЗаполнено(СуммаВыплаты) Или СуммаВыплаты <= 0 Тогда
			СуммаВыплаты = ДоступныйОстаток;
		КонецЕсли;

		Если СуммаВыплаты <= 0 Тогда
			ОбщегоНазначения.СообщитьПользователю(
				СтрШаблон(НСтр("ru='Нет задолженности перед сотрудником %1 для выплаты.'"), СтрокаВыплаты.Сотрудник));
			Отказ = Истина;
			Возврат;
		КонецЕсли;

		ВКМ_ЗаблокироватьВзаиморасчетыПоСотруднику(СтрокаВыплаты.Сотрудник);
		ДоступныйОстаток = ВКМ_ПолучитьОстатокВзаиморасчетов(СтрокаВыплаты.Сотрудник, Дата);

		Если СуммаВыплаты > ДоступныйОстаток Тогда
			ОбщегоНазначения.СообщитьПользователю(
				СтрШаблон(НСтр("ru='Сумма выплаты превышает остаток взаиморасчетов с сотрудником %1.'"), СтрокаВыплаты.Сотрудник));
			Отказ = Истина;
			Возврат;
		КонецЕсли;

		Движение = Движения.ВКМ_ВзаиморасчетыССотрудниками.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = Дата;
		Движение.ВКМ_Сотрудник = СтрокаВыплаты.Сотрудник;
		Движение.ВКМ_Сумма = СуммаВыплаты;
	КонецЦикла;

КонецПроцедуры

Процедура ВКМ_ЗаполнитьПоОстаткамВзаиморасчетов() Экспорт

	ВКМ_Выплаты.Очистить();

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Взаиморасчеты.ВКМ_Сотрудник КАК ВКМ_Сотрудник,
	|	Взаиморасчеты.ВКМ_СуммаОстаток КАК ВКМ_Сумма
	|ИЗ
	|	РегистрНакопления.ВКМ_ВзаиморасчетыССотрудниками.Остатки(&ДатаДокумента, ) КАК Взаиморасчеты
	|ГДЕ
	|	Взаиморасчеты.ВКМ_СуммаОстаток > 0";
	Запрос.УстановитьПараметр("ДатаДокумента", ?(ЗначениеЗаполнено(Дата), Дата, ТекущаяДатаСеанса()));

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ВКМ_Выплаты.Добавить();
		НоваяСтрока.ВКМ_Сотрудник = Выборка.ВКМ_Сотрудник;
		НоваяСтрока.ВКМ_Сумма = Выборка.ВКМ_Сумма;
	КонецЦикла;

КонецПроцедуры

Функция ВКМ_СтрокиВыплатДляПроведения()

	СтрокиВыплат = Новый Массив;

	Если ВКМ_Выплаты.Количество() > 0 Тогда
		Для Каждого СтрокаТЧ Из ВКМ_Выплаты Цикл
			СтрокиВыплат.Добавить(Новый Структура("Сотрудник, Сумма",
				СтрокаТЧ.ВКМ_Сотрудник, СтрокаТЧ.ВКМ_Сумма));
		КонецЦикла;
	ИначеЕсли ЗначениеЗаполнено(ВКМ_Сотрудник) Тогда
		СтрокиВыплат.Добавить(Новый Структура("Сотрудник, Сумма",
			ВКМ_Сотрудник, ВКМ_СуммаВыплаты));
	КонецЕсли;

	Возврат СтрокиВыплат;

КонецФункции

Функция ВКМ_ПолучитьОстатокВзаиморасчетов(Сотрудник, ДатаДокумента)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(Взаиморасчеты.ВКМ_СуммаОстаток, 0) КАК ВКМ_СуммаОстаток
	|ИЗ
	|	РегистрНакопления.ВКМ_ВзаиморасчетыССотрудниками.Остатки(&ДатаДокумента, ВКМ_Сотрудник = &Сотрудник) КАК Взаиморасчеты";
	Запрос.УстановитьПараметр("ДатаДокумента", ДатаДокумента);
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ВКМ_СуммаОстаток;
	КонецЕсли;

	Возврат 0;

КонецФункции

Процедура ВКМ_ЗаблокироватьВзаиморасчетыПоСотруднику(Сотрудник)

	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления.ВКМ_ВзаиморасчетыССотрудниками");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементБлокировки.УстановитьЗначение("ВКМ_Сотрудник", Сотрудник);
	Блокировка.Заблокировать();

КонецПроцедуры

#КонецЕсли
