#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	ВКМ_ЗаполнитьСотрудникиСтрокой();

КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)

	ВКМ_ЗаполнитьПоОстаткамВзаиморасчетов();

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)

	СтрокиВыплат = ВКМ_СтрокиВыплатДляПроведения();
	Если СтрокиВыплат.Количество() = 0 Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru='Не заполнены выплаты сотрудникам.'"));
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	СотрудникиВыплат = Новый Массив;
	Для Каждого СтрокаВыплаты Из СтрокиВыплат Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаВыплаты.Сотрудник) Тогда
			ОбщегоНазначения.СообщитьПользователю(НСтр("ru='Не заполнен сотрудник.'"));
			Отказ = Истина;
			Возврат;
		КонецЕсли;
		Если СотрудникиВыплат.Найти(СтрокаВыплаты.Сотрудник) = Неопределено Тогда
			СотрудникиВыплат.Добавить(СтрокаВыплаты.Сотрудник);
		КонецЕсли;
	КонецЦикла;

	ВКМ_ЗаблокироватьВзаиморасчетыПоСотрудникам(СотрудникиВыплат);

	Движения.ВКМ_ВзаиморасчетыССотрудниками.Записывать = Истина;
	Движения.ВКМ_ВзаиморасчетыССотрудниками.Очистить();
	Движения.ВКМ_ВзаиморасчетыССотрудниками.Записать();

	ОстаткиПоСотрудникам = ВКМ_ПолучитьОстаткиВзаиморасчетов(
		СотрудникиВыплат, ВКМ_МоментОстатковВзаиморасчетов());

	Для Каждого СтрокаВыплаты Из СтрокиВыплат Цикл
		ДоступныйОстаток = ОстаткиПоСотрудникам.Получить(СтрокаВыплаты.Сотрудник);
		Если ДоступныйОстаток = Неопределено Тогда
			ДоступныйОстаток = 0;
		КонецЕсли;

		СуммаВыплаты = СтрокаВыплаты.Сумма;
		Если НЕ ЗначениеЗаполнено(СуммаВыплаты) Или СуммаВыплаты <= 0 Тогда
			СуммаВыплаты = ДоступныйОстаток;
		КонецЕсли;

		Если СуммаВыплаты <= 0 Тогда
			ОбщегоНазначения.СообщитьПользователю(
				СтрШаблон(НСтр("ru='Нет задолженности перед сотрудником %1 для выплаты.'"), СтрокаВыплаты.Сотрудник));
			Отказ = Истина;
			Возврат;
		КонецЕсли;

		Если СуммаВыплаты > ДоступныйОстаток Тогда
			ОбщегоНазначения.СообщитьПользователю(
				СтрШаблон(НСтр("ru='Сумма выплаты превышает остаток взаиморасчетов с сотрудником %1.'"), СтрокаВыплаты.Сотрудник));
			Отказ = Истина;
			Возврат;
		КонецЕсли;

		Движение = Движения.ВКМ_ВзаиморасчетыССотрудниками.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = Дата;
		Движение.ВКМ_Сотрудник = СтрокаВыплаты.Сотрудник;
		Движение.ВКМ_Сумма = СуммаВыплаты;

		ОстаткиПоСотрудникам.Вставить(СтрокаВыплаты.Сотрудник, ДоступныйОстаток - СуммаВыплаты);
	КонецЦикла;

КонецПроцедуры

Процедура ВКМ_ЗаполнитьПоОстаткамВзаиморасчетов() Экспорт

	ВКМ_Выплаты.Очистить();

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Взаиморасчеты.ВКМ_Сотрудник КАК ВКМ_Сотрудник,
	|	Взаиморасчеты.ВКМ_СуммаОстаток КАК ВКМ_Сумма
	|ИЗ
	|	РегистрНакопления.ВКМ_ВзаиморасчетыССотрудниками.Остатки(&ДатаДокумента, ) КАК Взаиморасчеты
	|ГДЕ
	|	Взаиморасчеты.ВКМ_СуммаОстаток > 0";
	Запрос.УстановитьПараметр("ДатаДокумента", ВКМ_МоментОстатковВзаиморасчетов());

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ВКМ_Выплаты.Добавить();
		НоваяСтрока.ВКМ_Сотрудник = Выборка.ВКМ_Сотрудник;
		НоваяСтрока.ВКМ_Сумма = Выборка.ВКМ_Сумма;
	КонецЦикла;

КонецПроцедуры

Функция ВКМ_СтрокиВыплатДляПроведения()

	СтрокиВыплат = Новый Массив;

	Для Каждого СтрокаТЧ Из ВКМ_Выплаты Цикл
		СтрокиВыплат.Добавить(Новый Структура("Сотрудник, Сумма",
			СтрокаТЧ.ВКМ_Сотрудник, СтрокаТЧ.ВКМ_Сумма));
	КонецЦикла;

	Возврат СтрокиВыплат;

КонецФункции

Процедура ВКМ_ЗаполнитьСотрудникиСтрокой()

	ИменаСотрудников = Новый Массив;
	ОбработанныеСотрудники = Новый Соответствие;

	Для Каждого СтрокаТЧ Из ВКМ_Выплаты Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаТЧ.ВКМ_Сотрудник) Тогда
			Продолжить;
		КонецЕсли;
		Если ОбработанныеСотрудники.Получить(СтрокаТЧ.ВКМ_Сотрудник) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ОбработанныеСотрудники.Вставить(СтрокаТЧ.ВКМ_Сотрудник, Истина);
		ИменаСотрудников.Добавить(Строка(СтрокаТЧ.ВКМ_Сотрудник));
	КонецЦикла;

	ВКМ_СотрудникиСтрокой = СтрСоединить(ИменаСотрудников, ", ");

КонецПроцедуры

Функция ВКМ_МоментОстатковВзаиморасчетов()

	ДатаОстатков = ?(ЗначениеЗаполнено(Дата), Дата, ТекущаяДатаСеанса());
	Возврат Новый Граница(ДатаОстатков, ВидГраницы.Включая);

КонецФункции

Функция ВКМ_ПолучитьОстаткиВзаиморасчетов(Сотрудники, ДатаДокумента)

	Результат = Новый Соответствие;
	Если Сотрудники.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Взаиморасчеты.ВКМ_Сотрудник КАК ВКМ_Сотрудник,
	|	ЕСТЬNULL(Взаиморасчеты.ВКМ_СуммаОстаток, 0) КАК ВКМ_СуммаОстаток
	|ИЗ
	|	РегистрНакопления.ВКМ_ВзаиморасчетыССотрудниками.Остатки(&ДатаДокумента, ВКМ_Сотрудник В (&Сотрудники)) КАК Взаиморасчеты";
	Запрос.УстановитьПараметр("ДатаДокумента", ДатаДокумента);
	Запрос.УстановитьПараметр("Сотрудники", Сотрудники);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.ВКМ_Сотрудник, Выборка.ВКМ_СуммаОстаток);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура ВКМ_ЗаблокироватьВзаиморасчетыПоСотрудникам(Сотрудники)

	Если Сотрудники.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Блокировка = Новый БлокировкаДанных;
	Для Каждого Сотрудник Из Сотрудники Цикл
		ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления.ВКМ_ВзаиморасчетыССотрудниками");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.УстановитьЗначение("ВКМ_Сотрудник", Сотрудник);
	КонецЦикла;
	Блокировка.Заблокировать();

КонецПроцедуры

#КонецЕсли
