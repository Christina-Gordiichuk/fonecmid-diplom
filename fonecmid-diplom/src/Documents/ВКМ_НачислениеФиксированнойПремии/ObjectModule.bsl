#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	ВКМ_ЗаполнитьСотрудникиСтрокой();

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)

	СтрокиПремии = ВКМ_СтрокиПремииДляПроведения();
	Если СтрокиПремии.Количество() = 0 Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru='Не заполнен список сотрудников.'"));
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Движения.ВКМ_ДополнительныеНачисления.Записывать = Истина;
	Движения.ВКМ_Удержания.Записывать = Истина;
	Движения.ВКМ_ВзаиморасчетыССотрудниками.Записывать = Истина;

	Для Каждого СтрокаПремии Из СтрокиПремии Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаПремии.Сотрудник) Тогда
			ОбщегоНазначения.СообщитьПользователю(НСтр("ru='Не заполнен сотрудник.'"));
			Отказ = Истина;
			Возврат;
		КонецЕсли;

		Если НЕ ЗначениеЗаполнено(СтрокаПремии.СуммаПремии) Или СтрокаПремии.СуммаПремии <= 0 Тогда
			ОбщегоНазначения.СообщитьПользователю(НСтр("ru='Сумма премии должна быть больше нуля.'"));
			Отказ = Истина;
			Возврат;
		КонецЕсли;

		ДвижениеПремии = Движения.ВКМ_ДополнительныеНачисления.Добавить();
		ДвижениеПремии.ПериодРегистрации = НачалоМесяца(Дата);
		ДвижениеПремии.ВидРасчета = ПланыВидовРасчета.ВКМ_ДополнительныеНачисления.ВКМ_Премия;
		ДвижениеПремии.ВКМ_Сотрудник = СтрокаПремии.Сотрудник;
		ДвижениеПремии.БазовыйПериодНачало = НачалоМесяца(Дата);
		ДвижениеПремии.БазовыйПериодКонец = КонецМесяца(Дата);
		ДвижениеПремии.ВКМ_Результат = СтрокаПремии.СуммаПремии;
	КонецЦикла;

	Движения.ВКМ_ДополнительныеНачисления.Записать();

	Для Каждого СтрокаПремии Из СтрокиПремии Цикл
		НДФЛ = ВКМ_РасчетЗарплаты.ВКМ_РассчитатьНДФЛ(СтрокаПремии.СуммаПремии);

		ДвижениеНДФЛ = Движения.ВКМ_Удержания.Добавить();
		ДвижениеНДФЛ.ПериодРегистрации = НачалоМесяца(Дата);
		ДвижениеНДФЛ.ВидРасчета = ПланыВидовРасчета.ВКМ_Удержания.ВКМ_НДФЛ;
		ДвижениеНДФЛ.ВКМ_Сотрудник = СтрокаПремии.Сотрудник;
		ДвижениеНДФЛ.БазовыйПериодНачало = НачалоМесяца(Дата);
		ДвижениеНДФЛ.БазовыйПериодКонец = КонецМесяца(Дата);
		ДвижениеНДФЛ.ВКМ_Результат = НДФЛ;
	КонецЦикла;

	Движения.ВКМ_Удержания.Записать();

	Сотрудники = Новый Соответствие;
	Для Каждого СтрокаПремии Из СтрокиПремии Цикл
		Если ЗначениеЗаполнено(СтрокаПремии.Сотрудник) Тогда
			Сотрудники.Вставить(СтрокаПремии.Сотрудник, Истина);
		КонецЕсли;
	КонецЦикла;

	СуммыКВыплате = ВКМ_РасчетЗарплаты.ВКМ_СуммыВзаиморасчетовПоРегистратору(Ссылка);

	Для Каждого КлючИЗначение Из Сотрудники Цикл
		Сотрудник = КлючИЗначение.Ключ;
		СуммаКВыплате = СуммыКВыплате.Получить(Сотрудник);
		Если СуммаКВыплате = Неопределено Или СуммаКВыплате = 0 Тогда
			Продолжить;
		КонецЕсли;

		ДвижениеВзаиморасчетов = Движения.ВКМ_ВзаиморасчетыССотрудниками.Добавить();
		ДвижениеВзаиморасчетов.ВидДвижения = ВидДвиженияНакопления.Приход;
		ДвижениеВзаиморасчетов.Период = Дата;
		ДвижениеВзаиморасчетов.ВКМ_Сотрудник = Сотрудник;
		ДвижениеВзаиморасчетов.ВКМ_Сумма = СуммаКВыплате;
	КонецЦикла;

КонецПроцедуры

Функция ВКМ_СтрокиПремииДляПроведения()

	СтрокиПремии = Новый Массив;

	Для Каждого СтрокаТЧ Из ВКМ_СписокСотрудников Цикл
		СтрокиПремии.Добавить(Новый Структура("Сотрудник, СуммаПремии",
			СтрокаТЧ.ВКМ_Сотрудник, СтрокаТЧ.ВКМ_СуммаПремии));
	КонецЦикла;

	Возврат СтрокиПремии;

КонецФункции

Процедура ВКМ_ЗаполнитьСотрудникиСтрокой()

	ИменаСотрудников = Новый Массив;
	ОбработанныеСотрудники = Новый Соответствие;

	Для Каждого СтрокаТЧ Из ВКМ_СписокСотрудников Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаТЧ.ВКМ_Сотрудник) Тогда
			Продолжить;
		КонецЕсли;
		Если ОбработанныеСотрудники.Получить(СтрокаТЧ.ВКМ_Сотрудник) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ОбработанныеСотрудники.Вставить(СтрокаТЧ.ВКМ_Сотрудник, Истина);
		ИменаСотрудников.Добавить(Строка(СтрокаТЧ.ВКМ_Сотрудник));
	КонецЦикла;

	ВКМ_СотрудникиСтрокой = СтрСоединить(ИменаСотрудников, ", ");

КонецПроцедуры

#КонецЕсли
