#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Процедура ОбработкаПроведения(Отказ, Режим)

	СтрокиОтпусков = ВКМ_СтрокиОтпусковДляПроведения();
	Если СтрокиОтпусков.Количество() = 0 Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru='Не заполнены отпуска сотрудников.'"));
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	НаборЗаписей = РегистрыСведений.ВКМ_ПланОтпусковСотрудников.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ВКМ_ДокументОснование.Установить(Ссылка);
	НаборЗаписей.Прочитать();
	НаборЗаписей.Очистить();

	Для Каждого СтрокаОтпуска Из СтрокиОтпусков Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаОтпуска.Сотрудник)
			Или НЕ ЗначениеЗаполнено(СтрокаОтпуска.ДатаНачала)
			Или НЕ ЗначениеЗаполнено(СтрокаОтпуска.ДатаОкончания) Тогда
			ОбщегоНазначения.СообщитьПользователю(НСтр("ru='Не заполнены сотрудник или даты отпуска.'"));
			Отказ = Истина;
			Возврат;
		КонецЕсли;

		Если СтрокаОтпуска.ДатаОкончания < СтрокаОтпуска.ДатаНачала Тогда
			ОбщегоНазначения.СообщитьПользователю(НСтр("ru='Дата окончания отпуска меньше даты начала.'"));
			Отказ = Истина;
			Возврат;
		КонецЕсли;

		Если ВКМ_ЕстьПересечениеПериодовОтпуска(СтрокаОтпуска.Сотрудник, СтрокаОтпуска.ДатаНачала, СтрокаОтпуска.ДатаОкончания, Ссылка) Тогда
			ОбщегоНазначения.СообщитьПользователю(
				СтрШаблон(НСтр("ru='Найдено пересечение с уже запланированным отпуском сотрудника %1.'"), СтрокаОтпуска.Сотрудник));
			Отказ = Истина;
			Возврат;
		КонецЕсли;

		Запись = НаборЗаписей.Добавить();
		Запись.Период = Дата;
		Запись.ВКМ_Сотрудник = СтрокаОтпуска.Сотрудник;
		Запись.ВКМ_ДокументОснование = Ссылка;
		Запись.ВКМ_ДатаНачала = СтрокаОтпуска.ДатаНачала;
		Запись.ВКМ_ДатаОкончания = СтрокаОтпуска.ДатаОкончания;
		Запись.ВКМ_Комментарий = ВКМ_Комментарий;
	КонецЦикла;

	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	НаборЗаписей.Записать();

КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)

	НаборЗаписей = РегистрыСведений.ВКМ_ПланОтпусковСотрудников.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ВКМ_ДокументОснование.Установить(Ссылка);
	НаборЗаписей.Записать();

КонецПроцедуры

Функция ВКМ_СтрокиОтпусковДляПроведения()

	СтрокиОтпусков = Новый Массив;

	Если ВКМ_ОтпускаСотрудников.Количество() > 0 Тогда
		Для Каждого СтрокаТЧ Из ВКМ_ОтпускаСотрудников Цикл
			СтрокиОтпусков.Добавить(Новый Структура("Сотрудник, ДатаНачала, ДатаОкончания",
				СтрокаТЧ.ВКМ_Сотрудник, СтрокаТЧ.ВКМ_ДатаНачала, СтрокаТЧ.ВКМ_ДатаОкончания));
		КонецЦикла;
	ИначеЕсли ЗначениеЗаполнено(ВКМ_Сотрудник) Тогда
		СтрокиОтпусков.Добавить(Новый Структура("Сотрудник, ДатаНачала, ДатаОкончания",
			ВКМ_Сотрудник, ВКМ_ДатаНачала, ВКМ_ДатаОкончания));
	КонецЕсли;

	Возврат СтрокиОтпусков;

КонецФункции

Функция ВКМ_ЕстьПересечениеПериодовОтпуска(Сотрудник, ДатаНачала, ДатаОкончания, ДокументОснование)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПланОтпусков.ВКМ_Сотрудник КАК ВКМ_Сотрудник
	|ИЗ
	|	РегистрСведений.ВКМ_ПланОтпусковСотрудников КАК ПланОтпусков
	|ГДЕ
	|	ПланОтпусков.ВКМ_Сотрудник = &Сотрудник
	|	И ПланОтпусков.ВКМ_ДокументОснование <> &ДокументОснование
	|	И ПланОтпусков.ВКМ_ДатаНачала <= &ДатаОкончания
	|	И ПланОтпусков.ВКМ_ДатаОкончания >= &ДатаНачала";
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);

	Выборка = Запрос.Выполнить().Выбрать();
	Возврат Выборка.Следующий();

КонецФункции

#КонецЕсли
