#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Перем ВКМ_НужноУведомлениеПослеЗаписи;
Перем ВКМ_ТекстУведомленияПослеЗаписи;

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)

	ВКМ_Специалист = Пользователи.ТекущийПользователь();
	Если НЕ ЗначениеЗаполнено(ВКМ_ДатаПроведенияРабот) Тогда
		ВКМ_ДатаПроведенияРабот = ТекущаяДатаСеанса();
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ВКМ_ДатаВремяВыполнения) Тогда
		ВКМ_ДатаВремяВыполнения = ТекущаяДатаСеанса();
	КонецЕсли;

КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	ВКМ_ПроверитьАбонентскийДоговорИПериод(Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	ВКМ_СинхронизироватьДатуВыполнения();
	ВКМ_ПересчитатьСумму();
	ВКМ_ЗарегистрироватьУведомлениеПоСобытиюЗаписи();

КонецПроцедуры

Процедура ПриЗаписи(Отказ)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	Если Отказ Или НЕ ВКМ_НужноУведомлениеПослеЗаписи Тогда
		Возврат;
	КонецЕсли;

	ВКМ_ОбслуживаниеКлиентов.ВКМ_ДобавитьУведомлениеВОчередь(
		Ссылка,
		Контрагент,
		ВКМ_ТекстУведомленияПослеЗаписи);

	ВКМ_НужноУведомлениеПослеЗаписи = Ложь;
	ВКМ_ТекстУведомленияПослеЗаписи = "";

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)

	ВКМ_ПроверитьАбонентскийДоговорИПериод(Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	Движения.ВКМ_ВыполненныеКлиентуРаботы.Записывать = Истина;
	Движения.ВКМ_ВыполненныеСотрудникомРаботы.Записывать = Истина;

	ЧасыКОплатеКлиенту = ВКМ_ИтогЧасовКОплатеКлиенту();
	СтавкаЧасаКлиента = Договор.ВКМ_СтоимостьЧасаРаботы;
	СуммаКОплатеКлиенту = Окр(ЧасыКОплатеКлиенту * СтавкаЧасаКлиента, 2);

	Если ЧасыКОплатеКлиенту = 0 И СуммаКОплатеКлиенту = 0 Тогда
		Возврат;
	КонецЕсли;

	ДвижениеКлиенту = Движения.ВКМ_ВыполненныеКлиентуРаботы.Добавить();
	ДвижениеКлиенту.Период = Дата;
	ДвижениеКлиенту.ВКМ_Клиент = Контрагент;
	ДвижениеКлиенту.ВКМ_Договор = Договор;
	ДвижениеКлиенту.ВКМ_ЧасовКОплате = ЧасыКОплатеКлиенту;
	ДвижениеКлиенту.ВКМ_СуммаКОплате = СуммаКОплатеКлиенту;

	ПроцентСотрудника = ВКМ_ПроцентСотрудникаПоУсловиямОплаты(ВКМ_Специалист);
	Если ПроцентСотрудника = Неопределено Тогда
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Для специалиста не задано условие оплаты с процентом от работ на дату обслуживания.'"));
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	ДвижениеСотруднику = Движения.ВКМ_ВыполненныеСотрудникомРаботы.Добавить();
	ДвижениеСотруднику.Период = Дата;
	ДвижениеСотруднику.ВКМ_Сотрудник = ВКМ_Специалист;
	ДвижениеСотруднику.ВКМ_ЧасовКОплате = ЧасыКОплатеКлиенту;
	ДвижениеСотруднику.ВКМ_СуммаКОплате = Окр(ЧасыКОплатеКлиенту * СтавкаЧасаКлиента * ПроцентСотрудника / 100, 2);

КонецПроцедуры

#КонецОбласти

#Область ВКМ_СлужебныеПроцедурыИФункции

Процедура ВКМ_ПроверитьАбонентскийДоговорИПериод(Отказ)

	Если НЕ ЗначениеЗаполнено(Договор) Тогда
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Для документа обслуживания клиента необходимо указать договор.'"));
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	ВидАбонентскогоДоговора = Перечисления.ВидыДоговоровКонтрагентов.ВКМ_АбонентскоеОбслуживание;
	Если Договор.ВидДоговора <> ВидАбонентскогоДоговора Тогда
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Выбранный договор не относится к абонентскому обслуживанию.'"));
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	ДатаПроверки = Дата;
	Если ЗначениеЗаполнено(Договор.ВКМ_ДатаНачалаДействия)
		И ДатаПроверки < НачалоДня(Договор.ВКМ_ДатаНачалаДействия) Тогда
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Дата документа меньше даты начала действия договора.'"));
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(Договор.ВКМ_ДатаОкончанияДействия)
		И ДатаПроверки > КонецДня(Договор.ВКМ_ДатаОкончанияДействия) Тогда
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Дата документа больше даты окончания действия договора.'"));
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры

Процедура ВКМ_СинхронизироватьДатуВыполнения()

	Если ЗначениеЗаполнено(ВКМ_ДатаПроведенияРабот) Тогда
		ДатаВремя = ВКМ_ДатаПроведенияРабот;
		Если ЗначениеЗаполнено(ВКМ_ВремяНачалаРаботПлан) Тогда
			ДатаВремя = НачалоДня(ВКМ_ДатаПроведенияРабот)
				+ (ВКМ_ВремяНачалаРаботПлан - НачалоДня(ВКМ_ВремяНачалаРаботПлан));
		КонецЕсли;
		ВКМ_ДатаВремяВыполнения = ДатаВремя;
	ИначеЕсли ЗначениеЗаполнено(ВКМ_ДатаВремяВыполнения) Тогда
		ВКМ_ДатаПроведенияРабот = НачалоДня(ВКМ_ДатаВремяВыполнения);
	КонецЕсли;

КонецПроцедуры

Процедура ВКМ_ПересчитатьСумму()

	СтавкаЧасаКлиента = 0;
	Если ЗначениеЗаполнено(Договор) Тогда
		СтавкаЧасаКлиента = Договор.ВКМ_СтоимостьЧасаРаботы;
	КонецЕсли;

	Для Каждого СтрокаРабот Из ВКМ_ВыполненныеРаботы Цикл
		ЧасыКОплате = ВКМ_ЧасыКОплатеСтроки(СтрокаРабот);
		СтрокаРабот.ВКМ_СтоимостьЧаса = СтавкаЧасаКлиента;
		СтрокаРабот.ВКМ_Сумма = Окр(ЧасыКОплате * СтавкаЧасаКлиента, 2);
	КонецЦикла;

	ВКМ_СуммаДокумента = ВКМ_ВыполненныеРаботы.Итог("ВКМ_Сумма");

КонецПроцедуры

Функция ВКМ_ИтогЧасовКОплатеКлиенту()

	ИтогЧасов = 0;
	Для Каждого СтрокаРабот Из ВКМ_ВыполненныеРаботы Цикл
		ИтогЧасов = ИтогЧасов + ВКМ_ЧасыКОплатеСтроки(СтрокаРабот);
	КонецЦикла;

	Возврат ИтогЧасов;

КонецФункции

Функция ВКМ_ЧасыКОплатеСтроки(СтрокаРабот)

	Если ЗначениеЗаполнено(СтрокаРабот.ВКМ_ЧасыКОплатеКлиенту) Тогда
		Возврат СтрокаРабот.ВКМ_ЧасыКОплатеКлиенту;
	КонецЕсли;

	Возврат СтрокаРабот.ВКМ_Часы;

КонецФункции

Процедура ВКМ_ЗарегистрироватьУведомлениеПоСобытиюЗаписи()

	ВКМ_НужноУведомлениеПослеЗаписи = Ложь;
	ВКМ_ТекстУведомленияПослеЗаписи = "";

	НовыйДокумент = ЭтоНовый();
	ИзмененоКлючевоеПоле = Ложь;
	Если НЕ НовыйДокумент И ЗначениеЗаполнено(Ссылка) Тогда
		ПредыдущиеЗначения = ВКМ_ПрочитатьКлючевыеПоляДокумента(Ссылка);
		ИзмененоКлючевоеПоле =
			ПредыдущиеЗначения.ВКМ_ДатаПроведенияРабот <> ВКМ_ДатаПроведенияРабот
			ИЛИ ПредыдущиеЗначения.ВКМ_ВремяНачалаРаботПлан <> ВКМ_ВремяНачалаРаботПлан
			ИЛИ ПредыдущиеЗначения.ВКМ_ВремяОкончанияРаботПлан <> ВКМ_ВремяОкончанияРаботПлан
			ИЛИ ПредыдущиеЗначения.ВКМ_ДатаВремяВыполнения <> ВКМ_ДатаВремяВыполнения
			ИЛИ ПредыдущиеЗначения.ВКМ_Специалист <> ВКМ_Специалист;
	КонецЕсли;

	Если НЕ НовыйДокумент И НЕ ИзмененоКлючевоеПоле Тогда
		Возврат;
	КонецЕсли;

	ВКМ_ТекстУведомленияПослеЗаписи = ?(НовыйДокумент,
		СтрШаблон(НСтр("ru = 'Создано обслуживание клиента: %1 от %2, специалист: %3, время: %4 - %5'"),
			Номер,
			Формат(ВКМ_ДатаПроведенияРабот, "ДЛФ=D"),
			ВКМ_Специалист,
			Формат(ВКМ_ВремяНачалаРаботПлан, "ДФ=HH:mm"),
			Формат(ВКМ_ВремяОкончанияРаботПлан, "ДФ=HH:mm")),
		СтрШаблон(НСтр("ru = 'Изменено обслуживание клиента: %1. Дата: %2, время: %3 - %4, специалист: %5'"),
			Номер,
			Формат(ВКМ_ДатаПроведенияРабот, "ДЛФ=D"),
			Формат(ВКМ_ВремяНачалаРаботПлан, "ДФ=HH:mm"),
			Формат(ВКМ_ВремяОкончанияРаботПлан, "ДФ=HH:mm"),
			ВКМ_Специалист));
	ВКМ_НужноУведомлениеПослеЗаписи = Истина;

КонецПроцедуры

Функция ВКМ_ПрочитатьКлючевыеПоляДокумента(ДокументСсылка)

	Результат = Новый Структура(
		"ВКМ_ДатаПроведенияРабот, ВКМ_ВремяНачалаРаботПлан, ВКМ_ВремяОкончанияРаботПлан, ВКМ_ДатаВремяВыполнения, ВКМ_Специалист");

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДокументОбслуживания.ВКМ_ДатаПроведенияРабот КАК ВКМ_ДатаПроведенияРабот,
	|	ДокументОбслуживания.ВКМ_ВремяНачалаРаботПлан КАК ВКМ_ВремяНачалаРаботПлан,
	|	ДокументОбслуживания.ВКМ_ВремяОкончанияРаботПлан КАК ВКМ_ВремяОкончанияРаботПлан,
	|	ДокументОбслуживания.ВКМ_ДатаВремяВыполнения КАК ВКМ_ДатаВремяВыполнения,
	|	ДокументОбслуживания.ВКМ_Специалист КАК ВКМ_Специалист
	|ИЗ
	|	Документ.ВКМ_ОбслуживаниеКлиента КАК ДокументОбслуживания
	|ГДЕ
	|	ДокументОбслуживания.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция ВКМ_ПроцентСотрудникаПоУсловиямОплаты(Сотрудник)

	Если НЕ ЗначениеЗаполнено(Сотрудник) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	УсловияОплаты.ВКМ_ПроцентОтРабот КАК ВКМ_ПроцентОтРабот
	|ИЗ
	|	РегистрСведений.ВКМ_УсловияОплатыСотрудников КАК УсловияОплаты
	|ГДЕ
	|	УсловияОплаты.ВКМ_Сотрудник = &Сотрудник
	|	И УсловияОплаты.Период <= &ДатаДокумента
	|УПОРЯДОЧИТЬ ПО
	|	УсловияОплаты.Период УБЫВ";
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	Запрос.УстановитьПараметр("ДатаДокумента", Дата);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ВКМ_ПроцентОтРабот;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

#КонецОбласти

#КонецЕсли
