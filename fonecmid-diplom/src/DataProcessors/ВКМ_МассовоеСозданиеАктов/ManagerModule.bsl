#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Функция ВКМ_СоздатьРеализацииЗаМесяц(Период) Экспорт

	Результат = Новый Структура("Создано, Ошибки, Строки", 0, Новый Массив, Новый Массив);

	Если НЕ ЗначениеЗаполнено(Период) Тогда
		Результат.Ошибки.Добавить(НСтр("ru = 'Не указан период.'"));
		Возврат Результат;
	КонецЕсли;

	ОбработкаОбъект = Создать();
	ТаблицаДоговоров = ОбработкаОбъект.ВКМ_ЗаполнитьСписокДоговоров(Период);

	Для Каждого СтрокаДоговора Из ТаблицаДоговоров Цикл
		ОписаниеСтроки = Новый Структура("ВКМ_Договор, ВКМ_Контрагент, ВКМ_Реализация, ВКМ_Статус");
		ЗаполнитьЗначенияСвойств(ОписаниеСтроки, СтрокаДоговора);

		Если ЗначениеЗаполнено(СтрокаДоговора.ВКМ_Реализация) Тогда
			Результат.Строки.Добавить(ОписаниеСтроки);
			Продолжить;
		КонецЕсли;

		Попытка
			РеализацияОбъект = Документы.РеализацияТоваровУслуг.СоздатьДокумент();
			РеализацияОбъект.Дата = КонецМесяца(Период);
			РеализацияОбъект.Договор = СтрокаДоговора.ВКМ_Договор;
			РеализацияОбъект.Контрагент = СтрокаДоговора.ВКМ_Контрагент;
			РеализацияОбъект.Организация = СтрокаДоговора.ВКМ_Договор.Организация;
			РеализацияОбъект.Ответственный = Пользователи.ТекущийПользователь();
			РеализацияОбъект.ВыполнитьАвтозаполнение();

			Если РеализацияОбъект.Услуги.Количество() = 0 Тогда
				ОписаниеСтроки.ВКМ_Статус = НСтр("ru = 'Нет услуг для выставления'");
				Результат.Ошибки.Добавить(СтрШаблон(
					НСтр("ru = 'Договор %1: автозаполнение не дало услуг, документ не проведён.'"),
					СтрокаДоговора.ВКМ_Договор));
				Результат.Строки.Добавить(ОписаниеСтроки);
				Продолжить;
			КонецЕсли;

			Если НЕ РеализацияОбъект.ПроверитьЗаполнение() Тогда
				ОписаниеСтроки.ВКМ_Статус = НСтр("ru = 'Ошибка проверки заполнения'");
				Результат.Ошибки.Добавить(СтрШаблон(
					НСтр("ru = 'Договор %1: проверка заполнения не пройдена.'"),
					СтрокаДоговора.ВКМ_Договор));
				Результат.Строки.Добавить(ОписаниеСтроки);
				Продолжить;
			КонецЕсли;

			РеализацияОбъект.Записать(РежимЗаписиДокумента.Проведение);
			ОписаниеСтроки.ВКМ_Реализация = РеализацияОбъект.Ссылка;
			ОписаниеСтроки.ВКМ_Статус = НСтр("ru = 'Акт создан'");
			Результат.Создано = Результат.Создано + 1;
		Исключение
			ОписаниеСтроки.ВКМ_Статус = НСтр("ru = 'Ошибка создания'");
			Результат.Ошибки.Добавить(СтрШаблон(
				НСтр("ru = 'Договор %1: %2'"),
				СтрокаДоговора.ВКМ_Договор,
				КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
		КонецПопытки;

		Результат.Строки.Добавить(ОписаниеСтроки);
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#КонецЕсли
