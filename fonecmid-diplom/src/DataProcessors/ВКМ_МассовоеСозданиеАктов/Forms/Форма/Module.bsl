#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если НЕ ЗначениеЗаполнено(Объект.ВКМ_ПериодС) Тогда
		Объект.ВКМ_ПериодС = НачалоМесяца(ТекущаяДата());
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.ВКМ_ПериодПо) Тогда
		Объект.ВКМ_ПериодПо = КонецДня(ТекущаяДата());
	КонецЕсли;

	ВКМ_ЗаполнитьТаблицуЗаказовНаСервере();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВКМ_Заполнить(Команда)

	ВКМ_ЗаполнитьТаблицуЗаказовНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ВКМ_СоздатьАкты(Команда)

	РезультатЗапуска = ВКМ_СоздатьАктыНаСервере();
	Если РезультатЗапуска = Неопределено Тогда
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Не выбраны заказы для создания актов или акты уже существуют.'"));
		Возврат;
	КонецЕсли;

	ОбщегоНазначения.СообщитьПользователю(
		НСтр("ru = 'Массовое создание актов запущено в фоне.'"));
	ВКМ_ЗаполнитьТаблицуЗаказовНаСервере();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ВКМ_ЗаполнитьТаблицуЗаказовНаСервере()

	ТаблицаЗаказов = Объект.ВКМ_ЗаполнитьСписокЗаказов(Объект.ВКМ_ПериодС, Объект.ВКМ_ПериодПо);
	Объект.ВКМ_Заказы.Очистить();
	Для Каждого СтрокаЗаказа Из ТаблицаЗаказов Цикл
		НоваяСтрока = Объект.ВКМ_Заказы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаЗаказа);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция ВКМ_СоздатьАктыНаСервере()

	ИдентификаторОперации = Новый УникальныйИдентификатор;
	Возврат Объект.ВКМ_ВыполнитьМассовоеСозданиеАктов(Объект.ВКМ_Заказы.Выгрузить(), ИдентификаторОперации);

КонецФункции

#КонецОбласти
