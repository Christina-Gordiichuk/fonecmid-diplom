#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Функция ВКМ_ЗаполнитьСписокЗаказов(ПериодС, ПериодПо) Экспорт

	ТаблицаЗаказов = Новый ТаблицаЗначений;
	ТаблицаЗаказов.Колонки.Добавить("ВКМ_Выбран", Новый ОписаниеТипов("Булево"));
	ТаблицаЗаказов.Колонки.Добавить("ВКМ_Заказ", Новый ОписаниеТипов("ДокументСсылка.ЗаказПокупателя"));
	ТаблицаЗаказов.Колонки.Добавить("ВКМ_Дата", Новый ОписаниеТипов("Дата"));
	ТаблицаЗаказов.Колонки.Добавить("ВКМ_Контрагент", Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ТаблицаЗаказов.Колонки.Добавить("ВКМ_Сумма", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
	ТаблицаЗаказов.Колонки.Добавить("ВКМ_Статус", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(120)));

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Заказы.Ссылка КАК Заказ,
	|	Заказы.Дата КАК Дата,
	|	Заказы.Контрагент КАК Контрагент,
	|	Заказы.СуммаДокумента КАК СуммаДокумента
	|ИЗ
	|	Документ.ЗаказПокупателя КАК Заказы
	|ГДЕ
	|	Заказы.Проведен
	|	И Заказы.Дата МЕЖДУ &ПериодС И &ПериодПо
	|
	|УПОРЯДОЧИТЬ ПО
	|	Заказы.Дата";

	Запрос.УстановитьПараметр("ПериодС", НачалоДня(ПериодС));
	Запрос.УстановитьПараметр("ПериодПо", КонецДня(ПериодПо));

	МассивЗаказов = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ТаблицаЗаказов.Добавить();
		НоваяСтрока.ВКМ_Выбран = Истина;
		НоваяСтрока.ВКМ_Заказ = Выборка.Заказ;
		НоваяСтрока.ВКМ_Дата = Выборка.Дата;
		НоваяСтрока.ВКМ_Контрагент = Выборка.Контрагент;
		НоваяСтрока.ВКМ_Сумма = Выборка.СуммаДокумента;
		МассивЗаказов.Добавить(Выборка.Заказ);
	КонецЦикла;

	ЗаказыСАктами = ВКМ_ПолучитьСоответствиеЗаказовСАктами(МассивЗаказов);
	Для Каждого СтрокаЗаказа Из ТаблицаЗаказов Цикл
		СтрокаЗаказа.ВКМ_Статус = ?(ЗаказыСАктами.СодержитКлюч(СтрокаЗаказа.ВКМ_Заказ),
			НСтр("ru = 'Акт уже создан'"),
			НСтр("ru = 'Готов к созданию акта'"));
	КонецЦикла;

	Возврат ТаблицаЗаказов;

КонецФункции

Функция ВКМ_ВыполнитьМассовоеСозданиеАктов(ТаблицаЗаказов, ИдентификаторОперации = Неопределено) Экспорт

	СсылкиЗаказов = ВКМ_ПодготовитьВыбранныеЗаказы(ТаблицаЗаказов);
	Если СсылкиЗаказов.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(ИдентификаторОперации);
	ПараметрыВыполнения.ЗапуститьВФоне = Истина;
	ПараметрыВыполнения.ОжидатьЗавершение = 0;
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Массовое создание актов по заказам'");

	Возврат ДлительныеОперации.ВыполнитьФункцию(
		ПараметрыВыполнения,
		"Документы.ЗаказПокупателя.ВКМ_СоздатьАктыПоЗаказамВФоне",
		СсылкиЗаказов);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ВКМ_ПодготовитьВыбранныеЗаказы(ТаблицаЗаказов)

	СсылкиЗаказов = Новый Массив;
	Если ТаблицаЗаказов = Неопределено Тогда
		Возврат СсылкиЗаказов;
	КонецЕсли;

	ВыбранныеСсылки = Новый Массив;
	Для Каждого СтрокаЗаказа Из ТаблицаЗаказов Цикл
		Если НЕ СтрокаЗаказа.ВКМ_Выбран Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(СтрокаЗаказа.ВКМ_Заказ) Тогда
			Продолжить;
		КонецЕсли;
		ВыбранныеСсылки.Добавить(СтрокаЗаказа.ВКМ_Заказ);
	КонецЦикла;

	ЗаказыСАктами = ВКМ_ПолучитьСоответствиеЗаказовСАктами(ВыбранныеСсылки);
	Для Каждого СсылкаЗаказа Из ВыбранныеСсылки Цикл
		Если НЕ ЗаказыСАктами.СодержитКлюч(СсылкаЗаказа) Тогда
			СсылкиЗаказов.Добавить(СсылкаЗаказа);
		КонецЕсли;
	КонецЦикла;

	Возврат СсылкиЗаказов;

КонецФункции

Функция ВКМ_ПолучитьСоответствиеЗаказовСАктами(МассивЗаказов)

	СоответствиеЗаказов = Новый Соответствие;
	Если МассивЗаказов = Неопределено Или МассивЗаказов.Количество() = 0 Тогда
		Возврат СоответствиеЗаказов;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Акты.Основание КАК ЗаказПокупателя
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК Акты
	|ГДЕ
	|	Акты.Основание ССЫЛКА Документ.ЗаказПокупателя
	|	И Акты.Основание В (&МассивЗаказов)";
	Запрос.УстановитьПараметр("МассивЗаказов", МассивЗаказов);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СоответствиеЗаказов.Вставить(Выборка.ЗаказПокупателя, Истина);
	КонецЦикла;

	Возврат СоответствиеЗаказов;

КонецФункции

#КонецОбласти

#КонецЕсли
