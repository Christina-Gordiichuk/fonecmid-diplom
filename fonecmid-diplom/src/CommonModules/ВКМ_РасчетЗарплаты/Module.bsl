#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Возвращает сумму НДФЛ 13% от суммы начисления.
//
// Параметры:
//  СуммаНачисления - Число - сумма, с которой удерживается налог.
//
// Возвращаемое значение:
//  Число - сумма НДФЛ; 0, если начисление не положительное.
//
Функция ВКМ_РассчитатьНДФЛ(СуммаНачисления) Экспорт

	Если СуммаНачисления <= 0 Тогда
		Возврат 0;
	КонецЕсли;

	Возврат Окр(СуммаНачисления * ВКМ_СтавкаНДФЛ(), ВКМ_РазрядностьСуммы());

КонецФункции

// Заполняет график работы пн-пт = 1, сб-вс = 0 на указанный интервал.
//
// Параметры:
//  ДатаНачала - Дата - первый день интервала графика.
//  ДатаОкончания - Дата - последний день интервала графика.
//
Процедура ВКМ_ОбеспечитьГрафикРаботы(ДатаНачала, ДатаОкончания) Экспорт

	Если НЕ ЗначениеЗаполнено(ДатаНачала) Или НЕ ЗначениеЗаполнено(ДатаОкончания) Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	График.ВКМ_Дата КАК ВКМ_Дата
	|ИЗ
	|	РегистрСведений.ВКМ_ГрафикиРаботы КАК График
	|ГДЕ
	|	График.ВКМ_Дата МЕЖДУ &ДатаНачала И &ДатаОкончания";
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ДатаНачала));
	Запрос.УстановитьПараметр("ДатаОкончания", НачалоДня(ДатаОкончания));

	СуществующиеДаты = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СуществующиеДаты.Вставить(НачалоДня(Выборка.ВКМ_Дата), Истина);
	КонецЦикла;

	НаборЗаписей = РегистрыСведений.ВКМ_ГрафикиРаботы.СоздатьНаборЗаписей();
	ТекущаяДатаГрафика = НачалоДня(ДатаНачала);
	КонецИнтервала = НачалоДня(ДатаОкончания);

	Пока ТекущаяДатаГрафика <= КонецИнтервала Цикл
		Если СуществующиеДаты.Получить(ТекущаяДатаГрафика) = Неопределено Тогда
			Запись = НаборЗаписей.Добавить();
			Запись.ВКМ_Дата = ТекущаяДатаГрафика;
			Запись.ВКМ_Значение = ?(ДеньНедели(ТекущаяДатаГрафика) <= ВКМ_НомерПоследнегоРабочегоДняНедели(), 1, 0);
		КонецЕсли;
		ТекущаяДатаГрафика = ТекущаяДатаГрафика + ВКМ_СекундВСутках();
	КонецЦикла;

	Если НаборЗаписей.Количество() > 0 Тогда
		НаборЗаписей.Записать(Ложь);
	КонецЕсли;

КонецПроцедуры

// Суммы процента от работ за месяц по списку сотрудников.
//
// Параметры:
//  Сотрудники - Массив - сотрудники, по которым нужны обороты.
//  ДатаПериода - Дата - любая дата месяца расчета.
//
// Возвращаемое значение:
//  Соответствие - ключ сотрудник, значение сумма к оплате за месяц.
//
Функция ВКМ_СуммыПроцентаОтРаботЗаМесяц(Сотрудники, ДатаПериода) Экспорт

	Результат = Новый Соответствие;
	Если Сотрудники.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Выработка.ВКМ_Сотрудник КАК ВКМ_Сотрудник,
	|	ЕСТЬNULL(СУММА(Выработка.ВКМ_СуммаКОплатеОборот), 0) КАК ВКМ_СуммаПоРаботам
	|ИЗ
	|	РегистрНакопления.ВКМ_ВыполненныеСотрудникомРаботы.Обороты(&НачалоПериода, &КонецПериода, Период, ВКМ_Сотрудник В (&Сотрудники)) КАК Выработка
	|
	|СГРУППИРОВАТЬ ПО
	|	Выработка.ВКМ_Сотрудник";
	Запрос.УстановитьПараметр("Сотрудники", Сотрудники);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоМесяца(ДатаПериода));
	Запрос.УстановитьПараметр("КонецПериода", КонецМесяца(ДатаПериода));

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.ВКМ_Сотрудник, Выборка.ВКМ_СуммаПоРаботам);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Рассчитывает записи основных начислений: оклад по ФПД и графику, отпуск по базе 12 месяцев.
//
// Параметры:
//  Регистратор - ДокументСсылка - документ начисления зарплаты.
//
Процедура ВКМ_РассчитатьОсновныеНачисления(Регистратор) Экспорт

	ВКМ_ОбеспечитьГрафикПоРегистраторуОсновныхНачислений(Регистратор);

	Выборка = ВКМ_ВыборкаДанныхРасчетаОсновныхНачислений(Регистратор);
	ФактДнейПоСтрокам = ВКМ_ФактическиеДниПоГрафику(Регистратор);
	НормаДнейПоСтрокам = ВКМ_НормаДнейПоГрафику(Регистратор);

	НаборЗаписей = РегистрыРасчета.ВКМ_ОсновныеНачисления.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Регистратор.Установить(Регистратор);
	НаборЗаписей.Прочитать();

	Пока Выборка.Следующий() Цикл
		ВКМ_РассчитатьСтрокуОсновныхНачислений(НаборЗаписей, Выборка, ФактДнейПоСтрокам, НормаДнейПоСтрокам);
	КонецЦикла;

	НаборЗаписей.Записать();

КонецПроцедуры

// База начислений (основные + дополнительные) по регистратору, в разрезе сотрудников.
//
// Параметры:
//  Регистратор - ДокументСсылка - документ-регистратор начисления или премии.
//
// Возвращаемое значение:
//  Соответствие - ключ сотрудник, значение сумма начислений по регистратору.
//
Функция ВКМ_БазаНачисленийПоРегистратору(Регистратор) Экспорт

	Результат = Новый Соответствие;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВложенныйЗапрос.ВКМ_Сотрудник КАК ВКМ_Сотрудник,
	|	ЕСТЬNULL(СУММА(ВложенныйЗапрос.Сумма), 0) КАК Сумма
	|ИЗ
	|	(ВЫБРАТЬ
	|		Основные.ВКМ_Сотрудник КАК ВКМ_Сотрудник,
	|		Основные.ВКМ_Результат КАК Сумма
	|	ИЗ
	|		РегистрРасчета.ВКМ_ОсновныеНачисления КАК Основные
	|	ГДЕ
	|		Основные.Регистратор = &Регистратор
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		Дополнительные.ВКМ_Сотрудник КАК ВКМ_Сотрудник,
	|		Дополнительные.ВКМ_Результат КАК Сумма
	|	ИЗ
	|		РегистрРасчета.ВКМ_ДополнительныеНачисления КАК Дополнительные
	|	ГДЕ
	|		Дополнительные.Регистратор = &Регистратор) КАК ВложенныйЗапрос
	|
	|СГРУППИРОВАТЬ ПО
	|	ВложенныйЗапрос.ВКМ_Сотрудник";
	Запрос.УстановитьПараметр("Регистратор", Регистратор);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.ВКМ_Сотрудник, Выборка.Сумма);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Суммы взаиморасчётов (основные + дополнительные - удержания) по регистратору.
//
// Параметры:
//  Регистратор - ДокументСсылка - документ-регистратор начисления или премии.
//
// Возвращаемое значение:
//  Соответствие - ключ сотрудник, значение сумма к выплате по регистратору.
//
Функция ВКМ_СуммыВзаиморасчетовПоРегистратору(Регистратор) Экспорт

	Результат = Новый Соответствие;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВложенныйЗапрос.ВКМ_Сотрудник КАК ВКМ_Сотрудник,
	|	ЕСТЬNULL(СУММА(ВложенныйЗапрос.Сумма), 0) КАК Сумма
	|ИЗ
	|	(ВЫБРАТЬ
	|		Основные.ВКМ_Сотрудник КАК ВКМ_Сотрудник,
	|		Основные.ВКМ_Результат КАК Сумма
	|	ИЗ
	|		РегистрРасчета.ВКМ_ОсновныеНачисления КАК Основные
	|	ГДЕ
	|		Основные.Регистратор = &Регистратор
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		Дополнительные.ВКМ_Сотрудник КАК ВКМ_Сотрудник,
	|		Дополнительные.ВКМ_Результат КАК Сумма
	|	ИЗ
	|		РегистрРасчета.ВКМ_ДополнительныеНачисления КАК Дополнительные
	|	ГДЕ
	|		Дополнительные.Регистратор = &Регистратор
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		Удержания.ВКМ_Сотрудник КАК ВКМ_Сотрудник,
	|		-Удержания.ВКМ_Результат КАК Сумма
	|	ИЗ
	|		РегистрРасчета.ВКМ_Удержания КАК Удержания
	|	ГДЕ
	|		Удержания.Регистратор = &Регистратор) КАК ВложенныйЗапрос
	|
	|СГРУППИРОВАТЬ ПО
	|	ВложенныйЗапрос.ВКМ_Сотрудник";
	Запрос.УстановитьПараметр("Регистратор", Регистратор);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.ВКМ_Сотрудник, Выборка.Сумма);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Заполняет табличную часть начисления зарплаты по условиям оплаты и плану отпусков.
//
// Параметры:
//  ДокументОбъект - ДокументОбъект - заполняемый документ начисления зарплаты.
//
Процедура ВКМ_ЗаполнитьНачисленияПоУсловиямОплаты(ДокументОбъект) Экспорт

	ДокументОбъект.ВКМ_Начисления.Очистить();

	ДатаДокумента = ?(ЗначениеЗаполнено(ДокументОбъект.Дата), ДокументОбъект.Дата, ТекущаяДатаСеанса());
	НачалоМесяцаДокумента = НачалоМесяца(ДатаДокумента);
	КонецМесяцаДокумента = КонецМесяца(ДатаДокумента);

	ВКМ_ОбеспечитьГрафикРаботы(НачалоМесяцаДокумента, КонецМесяцаДокумента);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УсловияОплаты.ВКМ_Сотрудник КАК ВКМ_Сотрудник,
	|	УсловияОплаты.ВКМ_ПроцентОтРабот КАК ВКМ_ПроцентОтРабот
	|ИЗ
	|	РегистрСведений.ВКМ_УсловияОплатыСотрудников.СрезПоследних(&ДатаДокумента, ИСТИНА) КАК УсловияОплаты";
	Запрос.УстановитьПараметр("ДатаДокумента", ДатаДокумента);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокаОклада = ДокументОбъект.ВКМ_Начисления.Добавить();
		СтрокаОклада.ВКМ_Сотрудник = Выборка.ВКМ_Сотрудник;
		СтрокаОклада.ВКМ_ВидРасчета = ПланыВидовРасчета.ВКМ_ОсновныеНачисления.ВКМ_Оклад;
		СтрокаОклада.ВКМ_ДатаНачала = НачалоМесяцаДокумента;
		СтрокаОклада.ВКМ_ДатаОкончания = НачалоДня(КонецМесяцаДокумента);

		Если Выборка.ВКМ_ПроцентОтРабот <> Неопределено Тогда
			СтрокаПроцента = ДокументОбъект.ВКМ_Начисления.Добавить();
			СтрокаПроцента.ВКМ_Сотрудник = Выборка.ВКМ_Сотрудник;
			СтрокаПроцента.ВКМ_ВидРасчета = ПланыВидовРасчета.ВКМ_ДополнительныеНачисления.ВКМ_ПроцентОтРабот;
			СтрокаПроцента.ВКМ_ДатаНачала = НачалоМесяцаДокумента;
			СтрокаПроцента.ВКМ_ДатаОкончания = НачалоДня(КонецМесяцаДокумента);
		КонецЕсли;
	КонецЦикла;

	ЗапросОтпусков = Новый Запрос;
	ЗапросОтпусков.Текст =
	"ВЫБРАТЬ
	|	ПланОтпусков.ВКМ_Сотрудник КАК ВКМ_Сотрудник,
	|	ПланОтпусков.ВКМ_ДатаНачала КАК ВКМ_ДатаНачала,
	|	ПланОтпусков.ВКМ_ДатаОкончания КАК ВКМ_ДатаОкончания
	|ИЗ
	|	РегистрСведений.ВКМ_ПланОтпусковСотрудников КАК ПланОтпусков
	|ГДЕ
	|	ПланОтпусков.ВКМ_ДатаНачала <= &КонецМесяца
	|	И ПланОтпусков.ВКМ_ДатаОкончания >= &НачалоМесяца";
	ЗапросОтпусков.УстановитьПараметр("НачалоМесяца", НачалоМесяцаДокумента);
	ЗапросОтпусков.УстановитьПараметр("КонецМесяца", КонецМесяцаДокумента);

	ВыборкаОтпусков = ЗапросОтпусков.Выполнить().Выбрать();
	Пока ВыборкаОтпусков.Следующий() Цикл
		ДатаНачала = Макс(НачалоДня(ВыборкаОтпусков.ВКМ_ДатаНачала), НачалоМесяцаДокумента);
		ДатаОкончания = Мин(НачалоДня(ВыборкаОтпусков.ВКМ_ДатаОкончания), НачалоДня(КонецМесяцаДокумента));

		СтрокаОтпуска = ДокументОбъект.ВКМ_Начисления.Добавить();
		СтрокаОтпуска.ВКМ_Сотрудник = ВыборкаОтпусков.ВКМ_Сотрудник;
		СтрокаОтпуска.ВКМ_ВидРасчета = ПланыВидовРасчета.ВКМ_ОсновныеНачисления.ВКМ_Отпуск;
		СтрокаОтпуска.ВКМ_ДатаНачала = ДатаНачала;
		СтрокаОтпуска.ВКМ_ДатаОкончания = ДатаОкончания;
	КонецЦикла;

	ВКМ_ЗаполнитьСуммыНачисленийДокумента(ДокументОбъект);

КонецПроцедуры

