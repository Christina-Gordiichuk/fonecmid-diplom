#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Отправляет текст уведомления в Telegram-чат контрагента или в чат по умолчанию.
//
// Параметры:
//  Контрагент - СправочникСсылка.Контрагенты - контрагент заявки; по нему ищется chat_id.
//  ТекстУведомления - Строка - текст сообщения для отправки.
//
// Возвращаемое значение:
//  Структура:
//   * Успешно - Булево - Истина, если Telegram вернул успешный ответ.
//   * ТекстОшибки - Строка - описание ошибки проверки параметров или HTTP-ответа.
//   * КодСостояния - Число - HTTP-код ответа Telegram; 0, если запрос не выполнялся.
//
Функция ВКМ_ОтправитьУведомлениеВТелеграм(Контрагент, ТекстУведомления) Экспорт

	Результат = Новый Структура("Успешно, ТекстОшибки, КодСостояния", Ложь, "", 0);
	ПараметрыОтправки = ВКМ_ПараметрыОтправкиTelegram(Контрагент, ТекстУведомления, Результат);
	Если ПараметрыОтправки <> Неопределено Тогда
		ВКМ_ВыполнитьHTTPЗапросTelegram(ПараметрыОтправки, ТекстУведомления, Результат);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Обрабатывает очередь уведомлений: отправляет сообщения и удаляет успешно отправленные элементы.
//
Процедура ВКМ_ОбработатьРегламентныеУведомления() Экспорт

	УведомленияКУдалению = Новый Массив;
	Выборка = Справочники.ВКМ_УведомленияТелеграмБоту.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.ПометкаУдаления Тогда
			Продолжить;
		КонецЕсли;

		РезультатОтправки = ВКМ_ОтправитьУведомлениеВТелеграм(Выборка.ВКМ_Контрагент, Выборка.ВКМ_ТекстСообщения);
		Если РезультатОтправки.Успешно Тогда
			УведомленияКУдалению.Добавить(Выборка.Ссылка);
		КонецЕсли;
	КонецЦикла;

	ВКМ_УдалитьОтправленныеУведомления(УведомленияКУдалению);

КонецПроцедуры

// Ставит уведомление в очередь справочника для последующей отправки регламентным заданием.
//
// Параметры:
//  ДокументОснование - ДокументСсылка.ВКМ_ОбслуживаниеКлиента - заявка, по которой формируется сообщение.
//  Контрагент - СправочникСсылка.Контрагенты - контрагент для выбора chat_id.
//  ТекстУведомления - Строка - текст сообщения.
//
Процедура ВКМ_ДобавитьУведомлениеВОчередь(ДокументОснование, Контрагент, ТекстУведомления) Экспорт

	Если НЕ ЗначениеЗаполнено(ДокументОснование) Тогда
		Возврат;
	КонецЕсли;

	Если ПустаяСтрока(СокрЛП(ТекстУведомления)) Тогда
		Возврат;
	КонецЕсли;

	УведомлениеОбъект = Справочники.ВКМ_УведомленияТелеграмБоту.СоздатьЭлемент();
	УведомлениеОбъект.ВКМ_ДокументОснование = ДокументОснование;
	УведомлениеОбъект.ВКМ_Контрагент = Контрагент;
	УведомлениеОбъект.ВКМ_ТекстСообщения = ТекстУведомления;
	УведомлениеОбъект.Записать();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Удаляет успешно отправленные уведомления из очереди.
//
// Параметры:
//  УведомленияКУдалению - Массив из СправочникСсылка.ВКМ_УведомленияТелеграмБоту - элементы очереди.
//
Процедура ВКМ_УдалитьОтправленныеУведомления(УведомленияКУдалению)

	Для Каждого УведомлениеСсылка Из УведомленияКУдалению Цикл
		Попытка
			УведомлениеОбъект = УведомлениеСсылка.ПолучитьОбъект();
			УведомлениеОбъект.Удалить();
		Исключение
			ЗаписьЖурналаРегистрации(
				НСтр("ru = 'ВКМ.Telegram'", ОбщегоНазначения.КодОсновногоЯзыка()),
				УровеньЖурналаРегистрации.Ошибка, , УведомлениеСсылка,
				ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры


// Проверяет текст и константы Telegram и возвращает параметры для HTTP-запроса.
//
// Параметры:
//  Контрагент - СправочникСсылка.Контрагенты - контрагент заявки.
//  ТекстУведомления - Строка - текст сообщения.
//  Результат - Структура - заполняется полем ТекстОшибки при неуспешной проверке.
//
// Возвращаемое значение:
//  Структура, Неопределено - ключи ТокенБота и ИдентификаторЧата либо Неопределено, если отправка невозможна.
//
Функция ВКМ_ПараметрыОтправкиTelegram(Контрагент, ТекстУведомления, Результат)

	ПараметрыОтправки = Неопределено;
	Если НЕ ЗначениеЗаполнено(ТекстУведомления) Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Не задан текст уведомления.'");
	Иначе
		ТокенБота = Константы.ВКМ_ТокенTelegramБота.Получить();
		ИдентификаторЧата = ВКМ_ОпределитьИдентификаторЧатаTelegram(Контрагент);
		Если ПустаяСтрока(СокрЛП(ТокенБота)) Или ПустаяСтрока(СокрЛП(ИдентификаторЧата)) Тогда
			Результат.ТекстОшибки = НСтр("ru = 'Не определены параметры Telegram (токен или chat_id по контрагенту/по умолчанию).'");
		Иначе
			ПараметрыОтправки = Новый Структура("ТокенБота, ИдентификаторЧата", ТокенБота, ИдентификаторЧата);
		КонецЕсли;
	КонецЕсли;

	Возврат ПараметрыОтправки;

КонецФункции

// Выполняет HTTP-запрос sendMessage к Telegram Bot API.
//
// Параметры:
//  ПараметрыОтправки - Структура:
//   * ТокенБота - Строка - токен управления ботом.
//   * ИдентификаторЧата - Строка - идентификатор чата получателя.
//  ТекстУведомления - Строка - текст сообщения.
//  Результат - Структура - заполняется признаком успеха, кодом состояния и текстом ошибки.
//
Процедура ВКМ_ВыполнитьHTTPЗапросTelegram(ПараметрыОтправки, ТекстУведомления, Результат)

	ИнтернетПрокси = Неопределено;
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.ПолучениеФайловИзИнтернета") Тогда
		МодульПолучениеФайловИзИнтернета = ОбщегоНазначения.ОбщийМодуль("ПолучениеФайловИзИнтернета");
		ИнтернетПрокси = МодульПолучениеФайловИзИнтернета.ПолучитьПрокси("https");
	КонецЕсли;

	Соединение = Новый HTTPСоединение("api.telegram.org", 443, , , ИнтернетПрокси, 30,
		ОбщегоНазначенияКлиентСервер.НовоеЗащищенноеСоединение());
	Запрос = Новый HTTPЗапрос("/bot" + ПараметрыОтправки.ТокенБота + "/sendMessage");
	Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Запрос.УстановитьТелоИзСтроки(
		ВКМ_СформироватьJSONЗапросаTelegram(ПараметрыОтправки.ИдентификаторЧата, ТекстУведомления),
		КодировкаТекста.UTF8);

	ОтправкаВыполнена = Ложь;
	Попытка
		Ответ = Соединение.ВызватьHTTPМетод("POST", Запрос);
		ОтправкаВыполнена = Истина;
	Исключение
		Результат.ТекстОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ВКМ_ЗаписатьОшибкуTelegram(Результат.ТекстОшибки);
	КонецПопытки;

	Если ОтправкаВыполнена Тогда
		ВКМ_РазобратьОтветTelegram(Ответ, Результат);
	КонецЕсли;

КонецПроцедуры

// Разбирает HTTP-ответ Telegram и заполняет результат отправки.
//
// Параметры:
//  Ответ - HTTPОтвет - ответ метода sendMessage.
//  Результат - Структура - заполняется кодом состояния, признаком успеха и текстом ошибки.
//
Процедура ВКМ_РазобратьОтветTelegram(Ответ, Результат)

	Результат.КодСостояния = Ответ.КодСостояния;
	ТелоОтвета = Ответ.ПолучитьТелоКакСтроку();
	Если Ответ.КодСостояния = 200 И СтрНайти(НРег(ТелоОтвета), """ok"":true") > 0 Тогда
		Результат.Успешно = Истина;
	Иначе
		Результат.ТекстОшибки = ?(ПустаяСтрока(ТелоОтвета),
			СтрШаблон(НСтр("ru = 'HTTP-ответ Telegram: код состояния %1, тело отсутствует.'"), Ответ.КодСостояния),
			ТелоОтвета);
		ВКМ_ЗаписатьОшибкуTelegram(СтрШаблон(НСтр("ru = 'Код состояния %1. %2'"), Ответ.КодСостояния, Результат.ТекстОшибки));
	КонецЕсли;

КонецПроцедуры

// Пишет ошибку интеграции с Telegram в журнал регистрации.
//
// Параметры:
//  ТекстОшибки - Строка - текст для записи в журнал.
//
Процедура ВКМ_ЗаписатьОшибкуTelegram(ТекстОшибки)

	ЗаписьЖурналаРегистрации(
		НСтр("ru = 'ВКМ.Telegram'", ОбщегоНазначения.КодОсновногоЯзыка()),
		УровеньЖурналаРегистрации.Ошибка, , ,
		ТекстОшибки);

КонецПроцедуры

// Определяет идентификатор чата: сначала по контрагенту, иначе из константы по умолчанию.
//
// Параметры:
//  Контрагент - СправочникСсылка.Контрагенты - контрагент заявки.
//
// Возвращаемое значение:
//  Строка - идентификатор чата Telegram.
//
Функция ВКМ_ОпределитьИдентификаторЧатаTelegram(Контрагент)

	ИдентификаторЧатаКонтрагента = ВКМ_ПолучитьИдентификаторЧатаКонтрагента(Контрагент);
	Если НЕ ПустаяСтрока(СокрЛП(ИдентификаторЧатаКонтрагента)) Тогда
		Возврат ИдентификаторЧатаКонтрагента;
	КонецЕсли;

	Возврат Константы.ВКМ_ИдентификаторЧатаTelegram.Получить();

КонецФункции

// Возвращает актуальный идентификатор чата из регистра маршрутизации по контрагенту.
//
// Параметры:
//  Контрагент - СправочникСсылка.Контрагенты - контрагент заявки.
//
// Возвращаемое значение:
//  Строка - идентификатор чата или пустая строка, если маршрут не задан.
//
Функция ВКМ_ПолучитьИдентификаторЧатаКонтрагента(Контрагент)

	Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
		Возврат "";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Маршрутизация.ВКМ_ИдентификаторЧата КАК ВКМ_ИдентификаторЧата
	|ИЗ
	|	РегистрСведений.ВКМ_МаршрутизацияTelegramКонтрагентов КАК Маршрутизация
	|ГДЕ
	|	Маршрутизация.ВКМ_Контрагент = &Контрагент
	|	И НЕ ПустаяСтрока(Маршрутизация.ВКМ_ИдентификаторЧата)
	|УПОРЯДОЧИТЬ ПО
	|	Маршрутизация.Период УБЫВ";
	Запрос.УстановитьПараметр("Контрагент", Контрагент);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ВКМ_ИдентификаторЧата;
	КонецЕсли;

	Возврат "";

КонецФункции

// Формирует JSON-тело запроса sendMessage.
//
// Параметры:
//  ИдентификаторЧата - Строка - идентификатор чата получателя.
//  ТекстУведомления - Строка - текст сообщения.
//
// Возвращаемое значение:
//  Строка - сериализованный JSON с полями chat_id и text.
//
Функция ВКМ_СформироватьJSONЗапросаTelegram(ИдентификаторЧата, ТекстУведомления)

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Новый Структура("chat_id, text", ИдентификаторЧата, ТекстУведомления));
	Возврат ЗаписьJSON.Закрыть();

КонецФункции

#КонецОбласти

#КонецЕсли
